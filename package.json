{
  "name": "pelican-pedal-run",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "鹈鹕骑车：基于 Three.js 的海岛 3D 骑行小游戏",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build --base=./",
    "preview": "vite preview --host 0.0.0.0",
    "desktop": "npm run build && electron desktop/main.cjs",
    "pack:win": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "com.pelican.pedalrun",
    "productName": "Pelican Pedal Run",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "Pelican-Pedal-Run-${version}-portable.exe"
    }
  }
}
